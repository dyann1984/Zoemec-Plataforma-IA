rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Misma logica de administrador que el codigo (src/domain/permissions.js,
    // server/api-lib/_authGuard.mjs): antes esta funcion solo aceptaba
    // role == 'admin' exacto en Firestore, sin variantes ni respaldo. Si ese
    // campo no traia exactamente ese valor, ni el custom claim de Firebase ni
    // el correo del admin real servian de nada aqui (aunque el codigo si los
    // aceptara), y funciones como listar Usuarios en Panel Admin fallaban con
    // "Missing or insufficient permissions" para un administrador real.
    function isAdmin() {
      return signedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.lower()
          in ['admin', 'administrator', 'administrador', 'superadmin']
        || request.auth.token.admin == true
        || request.auth.token.email.lower() == 'dianalopez161184@gmail.com'
      );
    }

    match /users/{uid}/state/{stateKey} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // El propio dueno solo puede crear su perfil con privilegios de arranque
      // fijos (role=user, plan=Gratis, active=true): evita que alguien use el
      // SDK de cliente directo para crearse ya como admin/Empresa antes de que
      // la app cree el documento por su cuenta. Un admin real (Admin SDK, que
      // ignora estas reglas) sigue pudiendo crear perfiles con otros valores.
      allow create: if isOwner(uid)
        && request.resource.data.role == 'user'
        && request.resource.data.plan == 'Gratis'
        && request.resource.data.active == true;
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.plan == resource.data.plan
          && request.resource.data.active == resource.data.active
        );
      allow delete: if isAdmin();
    }

    match /devices/{deviceId} {
      // "get" (un id de dispositivo conocido, el que ya trae el propio
      // navegador en localStorage) sigue abierto a cualquier cuenta
      // autenticada: el flujo de registro necesita poder comprobar si ESE
      // deviceId especifico ya se uso, sin importar quien lo registro antes.
      // "list" (consultar/enumerar TODA la coleccion) ahora es solo para
      // administradores: antes cualquier cuenta autenticada podia hacer
      // getDocs(collection(db,'devices')) y obtener email+uid de todos los
      // usuarios registrados en la plataforma.
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /library/{docId} {
      // La lectura solo se concede a: el administrador, el dueno del
      // documento, o cualquier usuario autenticado cuando el documento es
      // explicitamente global. Antes cualquier cuenta autenticada podia leer
      // TODA la coleccion, incluidos archivos marcados "private" de otros
      // usuarios/empresas (y su downloadURL firmada de larguisima duracion).
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (signedIn() && resource.data.visibility == 'global');
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.visibility in ['private', 'global']
        && (request.resource.data.visibility == 'private' || isAdmin());
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.visibility == resource.data.visibility
        );
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /visual_requests/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /payments/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /forum/{docId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Memoria Tecnica + decisiones de Challenge (Fase 6): toda escritura
    // pasa por api/technical-memory.mjs / api/challenge-decisions.mjs (SDK
    // admin, ignora estas reglas) para poder validar transiciones de estado,
    // resolver identidad del token real y usar transacciones -- el cliente
    // JAMAS escribe estas colecciones directo, mismo patron ya establecido
    // para "payments".
    //
    // FIX Fase 9 (hallazgo F-002, P0): la lectura YA NO es "cualquier cuenta
    // autenticada". El schema real (src/domain/technicalMemory.js) incluye
    // tipos como APPROVED_PRICE/PREFERRED_SUPPLIER con scope PROJECT/
    // ORGANIZATION -- precios aprobados y proveedores preferidos son
    // informacion de licitacion, no "dato tecnico generico". PoC real
    // confirmo que una cuenta ajena (SDK de cliente directo, sin pasar por
    // el endpoint) podia leer TODA la coleccion cross-tenant. La UI real
    // SIEMPRE lee via el endpoint (que si filtra por proyecto/usuario) y
    // NUNCA con el SDK de cliente directo -- por eso cerrar la lectura aqui
    // (igual que ya estaba escritura) no quita ninguna funcionalidad real,
    // mismo patron ya usado en projects/apus/apuVersions/exportEvents.
    match /technicalMemory/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /technicalMemoryAudit/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /challengeDecisions/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /challengeDecisionAudit/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Persistencia autoritativa de Proyecto/APU + versionado (Fase 7):
    // reemplaza SOLO para estas dos entidades el patron anterior de
    // users/{uid}/state (blob gzip via useCloudState -- ver src/cloud.js,
    // escritura directa del cliente sin validacion). Toda escritura aqui
    // pasa por api/projects.mjs / api/apus.mjs (SDK admin, ignora estas
    // reglas) para poder validar dueno real, usar transacciones y crear
    // version inmutable -- el cliente JAMAS escribe estas colecciones
    // directo (mismo patron que technicalMemory/challengeDecisions). La
    // lectura si es directa del dueno (dato propio, no requiere pasar por
    // el endpoint para consultarlo) o de un administrador.
    match /projects/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }
    match /projectAudit/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }
    match /apus/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }
    match /apuVersions/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }
    match /apuAudit/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    // Eventos de exportacion del Dossier APU Auditable (Fase 8, regla 22):
    // append-only, nunca editable ni borrable -- toda escritura pasa por
    // api/export-events.mjs (SDK admin). Mismo criterio de lectura que
    // apuAudit/projectAudit: solo el dueno del evento o un admin.
    match /exportEvents/{docId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
