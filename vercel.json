{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/apus", "destination": "/api/gateway" },
    { "source": "/api/projects", "destination": "/api/gateway" },
    { "source": "/api/challenge-decisions", "destination": "/api/gateway" },
    { "source": "/api/technical-memory", "destination": "/api/gateway" },
    { "source": "/api/export-events", "destination": "/api/gateway" },
    { "source": "/api/health", "destination": "/api/gateway" },
    { "source": "/api/organizations", "destination": "/api/gateway" },
    { "source": "/api/construction-proposal", "destination": "/api/gateway" },
    { "source": "/api/plano-takeoffs", "destination": "/api/gateway" },
    { "source": "/api/catalogo-conceptos", "destination": "/api/gateway" },
    { "source": "/api/presupuestos", "destination": "/api/gateway" },
    { "source": "/api/change-orders", "destination": "/api/gateway" },
    { "source": "/api/commitments", "destination": "/api/gateway" },
    { "source": "/api/progress", "destination": "/api/gateway" },
    { "source": "/api/estimates", "destination": "/api/gateway" },
    { "source": "/api/payments", "destination": "/api/gateway" },
    { "source": "/api/construction-dna", "destination": "/api/gateway" },
    { "source": "/api/project-vault", "destination": "/api/gateway" },
    { "source": "/api/sentinel", "destination": "/api/gateway" },
    { "source": "/api/assets", "destination": "/api/gateway" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/src/:path*", "destination": "/src/:path*" },
    { "source": "/@vite/:path*", "destination": "/@vite/:path*" },
    { "source": "/@react-refresh", "destination": "/@react-refresh" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
